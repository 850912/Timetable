<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene>
        <!-- AMOLED-safe base. -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="#000000" />
            </Rectangle>
        </PartDraw>

        <!--
            Interactive hero artwork.
            Uses the user's original cat-girl image. Only crop + left-side readability
            grading are applied; the character itself is not regenerated or redrawn.
        -->
        <PartImage x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="watchface_catgirl_bg_editorial" />
        </PartImage>

        <!-- Editorial stacked time: keeps the character's face unobstructed. -->
        <DigitalClock x="37" y="132" width="150" height="76">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TimeText x="0" y="0" width="150" height="76" format="hh" hourFormat="SYNC_TO_DEVICE" align="START">
                <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#78000000" />
            </TimeText>
        </DigitalClock>
        <DigitalClock x="35" y="130" width="150" height="76">
            <Variant mode="AMBIENT" target="alpha" value="180" />
            <TimeText x="0" y="0" width="150" height="76" format="hh" hourFormat="SYNC_TO_DEVICE" align="START">
                <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#FFFFFFFF" />
            </TimeText>
        </DigitalClock>

        <DigitalClock x="37" y="202" width="150" height="76">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TimeText x="0" y="0" width="150" height="76" format="mm" hourFormat="SYNC_TO_DEVICE" align="START">
                <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#78000000" />
            </TimeText>
        </DigitalClock>
        <DigitalClock x="35" y="200" width="150" height="76">
            <Variant mode="AMBIENT" target="alpha" value="180" />
            <TimeText x="0" y="0" width="150" height="76" format="mm" hourFormat="SYNC_TO_DEVICE" align="START">
                <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#FFFFFFFF" />
            </TimeText>
        </DigitalClock>

        <!-- Date is intentionally quiet and disappears in AOD. -->
        <PartText x="40" y="284" width="190" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="START" ellipsis="TRUE">
                <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#E6FFFFFF">
                    <Template><![CDATA[%s · %s %d]]><Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[MONTH_S]"/><Parameter expression="[DAY]"/></Template>
                </Font>
            </Text>
        </PartText>

        <!--
            One compact timetable complication: dynamic countdown/title on the left,
            course name on the right. Keeps the face useful without becoming a dashboard.
        -->
        <ComplicationSlot
            x="26" y="338" width="218" height="40"
            slotId="1"
            name="next_course"
            displayName="@string/next_course_slot_name"
            supportedTypes="SHORT_TEXT"
            isCustomizable="TRUE">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                primaryProvider="com.hufeng943.timetable/com.hufeng943.timetable.complication.NextCourseComplicationService"
                primaryProviderType="SHORT_TEXT"
                secondaryProvider="com.hufeng943.timetable.debug/com.hufeng943.timetable.complication.NextCourseComplicationService"
                secondaryProviderType="SHORT_TEXT"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingRoundBox x="0" y="0" width="218" height="40" cornerRadius="20" outlinePadding="2" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="218" height="40">
                    <RoundRectangle x="0" y="0" width="218" height="40" cornerRadiusX="20" cornerRadiusY="20">
                        <Fill color="#B2080E13" />
                    </RoundRectangle>
                    <RoundRectangle x="15" y="17" width="6" height="6" cornerRadiusX="3" cornerRadiusY="3">
                        <Fill color="#FF68E8F4" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="30" y="8" width="58" height="24">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" weight="MEDIUM" color="#FF68E8F4">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="88" y="7" width="116" height="26">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="15" weight="NORMAL" color="#F2FFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
