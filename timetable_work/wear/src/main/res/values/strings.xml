    <!-- About -->
    <string name="about_description">A timetable companion for Wear OS and Galaxy Watch with phone sync, offline schedules, reminders, academic tasks, Tiles, and complications.</string>
    <string name="about_features_title">Features</string>
    <string name="about_features_text">
        " · Multiple timetables with phone ↔ watch sync\n"
        " · Course editing, date exceptions, and quick same-day changes\n"
        " · Assignment / exam / lab tasks with reminders\n"
        " · Current-class-first home, next-class countdown, and after-class state\n"
        " · Wear Tile timeline and countdown / progress complications\n"
        " · Weekly timetable image sharing and input suggestions\n"
        " · ICS / CSV / JSON import, export, and system-calendar sync\n"
        " · 12/24-hour format, themes, and Chinese / English UI"
    </string>

    <string name="about_features_schedule">Classes: multiple timetables, date exceptions, same-day changes, and phone ↔ watch sync.</string>
    <string name="about_features_wear">Wear: status-first home, Tile timeline, current-class progress, and next-class countdown complications.</string>
    <string name="about_features_tools">Tools: academic tasks and reminders, weekly image sharing, ICS / CSV / JSON, and system calendar sync.</string>
    <string name="about_declaration_project">Project: continuously maintained from HuFeng943 / Timetable; current release 3.5.3.</string>
    <string name="about_declaration_development">Maintained by HeiBaiJun; some development used generative AI. Tap the version 7 times for Developer Options.</string>
    <string name="about_open_source_wear">Wear UI: Wear Compose 1.6.2 · Horologist 0.7.15</string>
    <string name="about_open_source_data">Data: Room 2.8.4 · Hilt 2.60 · KotlinX Serialization 1.11.0 · Datetime 0.8.0</string>
    <string name="about_open_source_ui">Tools: Coroutines 1.11.0 · AboutLibraries 15.0.3 · MaterialKolor 4.1.1. Open the license list below for full notices.</string>
    <string name="about_changelog_part1">3.5.3 focuses on Wear OS 6 reliability: nested-page motion no longer drags the parent screen away, Xiaomi/China-ROM haptics use a safe runtime fallback, and liquid glass now uses one tuned low-cost optical path.</string>
    <string name="about_changelog_part2">Backgrounds add image-tone fluid color generation, course cards are consolidated, and phone-to-watch legacy transfer compatibility remains available.</string>
    <string name="about_declaration_title">Declaration</string>
    <string name="about_declaration_subtitle" translatable="false">https://github.com/HuFeng943/Timetable</string>
    <string name="about_declaration_text">
        " · Current release uses semantic version 3.5.3\n"
        " · Original project: HuFeng943 / Timetable\n"
        " · Secondary development &amp; maintenance: 黑白君 (HeiBaiJun)\n"
        " · This version continues development on top of the original project\n"
        " · Some development and maintenance work is assisted by generative AI\n"
        " · Tap the version 7 times to open Developer Options"
    </string>
