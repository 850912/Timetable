    <!-- About -->
    <string name="about_description">    一款面向 Wear OS 与 Galaxy Watch 的课程表应用。支持手机同步、离线课表、Wear Tile 与表盘复杂功能。</string>
    <string name="about_features_title">主要功能</string>
    <string name="about_features_text">
        " · 多课表管理\n"
        " · 课程与课时编辑\n"
        " · ICS 日历导出 / CSV 表格导出\n"
        " · JSON 完整备份与恢复\n"
        " · Wear Tile 与表盘复杂功能\n"
        " · 主题预设与 Wear OS 动态配色\n"
        " · 12/24 小时制与每周起始日设置\n"
        " · 中文 / English 界面"
    </string>
    <string name="about_declaration_title">声明</string>
    <string name="about_declaration_text">
        " · Wear OS 应用，当前版本 2.0.0\n"
        " · 原项目：HuFeng943 / Timetable\n"
        " · 二次开发与维护：黑白君 (HeiBaiJun)\n"
        " · 当前版本在原项目基础上持续维护与扩展\n"
        " · 部分开发与维护工作借助生成式 AI 完成"
    </string>
